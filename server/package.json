{
  "name": "strassio-server",
  "private": true,
  "version": "0.1.0",
  "description": "Сервер лицензий и обновлений Strassio (docs/SPEC.md, разделы 13–15)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/*.test.js\"",
    "keys": "tsc -p tsconfig.json && node dist/scripts/generate-keys.js",
    "local": "tsc -p tsconfig.json && node dist/scripts/local-server.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
