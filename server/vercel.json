{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "tsc -p tsconfig.json --noEmit",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/api?__path=admin" },
    { "source": "/adminpanel", "destination": "/api?__path=admin" },
    { "source": "/api/:path*", "destination": "/api?__path=api/:path*" }
  ]
}
