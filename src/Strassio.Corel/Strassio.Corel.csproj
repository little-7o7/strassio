<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Strassio.Corel</RootNamespace>
    <AssemblyName>Strassio.Corel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Интероп собран tlbimp'ом из VGCoreAuto.tlb САМОЙ СТАРОЙ доступной версии CorelDRAW (2018, v20) —
      см. решение по совместимости в docs/SPEC.md, раздел "Совместимость с CorelDRAW".
      EmbedInteropTypes=true встраивает нужные типы прямо в Strassio.Corel.dll, отдельная Interop.VGCore.dll
      в выходе сборки не нужна и в Addons не копируется.
    -->
    <Reference Include="Corel.Interop.VGCore">
      <HintPath>interop\Corel.Interop.VGCore.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Interop — файл Corel, его нет в репозитории (см. README, «Для разработчиков»). -->
  <Target Name="StrassioCheckInterop" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(MSBuildThisFileDirectory)interop\Corel.Interop.VGCore.dll')">
    <Error Text="Нет файла src\Strassio.Corel\interop\Corel.Interop.VGCore.dll (interop CorelDRAW). Его нет в репозитории — это файл Corel. Положите его туда вручную, см. README, раздел «Для разработчиков»." />
  </Target>

  <ItemGroup>
    <!-- Стандартное окно выбора цвета Windows (редактор таблицы камней) — часть .NET Framework, не сторонняя библиотека. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strassio.Core\Strassio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Кнопка-камень, докер и маркер аддона — CorelDRAW читает их из папки Addons\Strassio рядом с DLL. -->
    <Content Include="AppUI.xslt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UserUI.xslt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Файлы языков (CLAUDE.md, правило 5) лежат в корне репозитория, в аддоне — в папке lang рядом с DLL. -->
    <Content Include="..\..\lang\*.json" Link="lang\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Те же файлы языков внутри DLL — запас, если папки lang рядом нет (см. PluginContext.BuiltInLanguage). -->
    <EmbeddedResource Include="..\..\lang\*.json" LogicalName="Strassio.lang.%(Filename)%(Extension)" />
    <Content Include="CorelDrw.addon">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
