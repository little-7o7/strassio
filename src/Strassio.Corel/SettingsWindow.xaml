<!-- Окно настроек Strassio (docs/SPEC.md, раздел 12). Тексты — из файлов языков, цвета — тема CorelDRAW. -->
<Window x:Class="Strassio.Corel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [settings.title]}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Strassio.Background}"
        Foreground="{DynamicResource Strassio.Foreground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding [settings.language]}" Style="{StaticResource Strassio.Caption}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LanguageCombo" Margin="0,0,0,8" DisplayMemberPath="Name"/>

            <TextBlock Grid.Row="1" Text="{Binding [settings.theme]}" Style="{StaticResource Strassio.Caption}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ThemeCombo" Margin="0,0,0,8" DisplayMemberPath="Text"
                      ToolTip="{Binding [settings.theme.tooltip]}"/>

            <TextBlock Grid.Row="2" Text="{Binding [settings.units]}" Style="{StaticResource Strassio.Caption}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="UnitsCombo" Margin="0,0,0,8" DisplayMemberPath="Text"
                      ToolTip="{Binding [settings.units.tooltip]}"/>

            <TextBlock Grid.Row="3" Text="{Binding [settings.decimals]}" Style="{StaticResource Strassio.Caption}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DecimalsCombo" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4" Text="{Binding [settings.outline]}" Style="{StaticResource Strassio.Caption}"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="OutlineCombo" Margin="0,0,0,8" DisplayMemberPath="Text"
                      SelectionChanged="OutlineCombo_SelectionChanged" ToolTip="{Binding [settings.outline.tooltip]}"/>

            <TextBlock Grid.Row="5" x:Name="OutlineWidthCaption" Style="{StaticResource Strassio.Caption}"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="OutlineWidthBox" Margin="0,0,0,8"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#E53935" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <DockPanel Margin="0,6,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{Binding [settings.openFolder]}" Click="OpenFolder_Click"
                    ToolTip="{Binding [settings.openFolder.tooltip]}"/>
            <Button DockPanel.Dock="Right" Content="{Binding [settings.cancel]}" IsCancel="True" Margin="6,0,0,0" MinWidth="80"/>
            <Button DockPanel.Dock="Right" Content="{Binding [settings.ok]}" IsDefault="True" Click="Ok_Click" MinWidth="80"
                    Style="{StaticResource Strassio.PrimaryButton}"/>
        </DockPanel>
    </StackPanel>
</Window>
