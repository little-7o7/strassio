<!--
  Внешний вид элементов докера Strassio. Все цвета берутся через DynamicResource из ключей
  "Strassio.*" — их подставляет ThemeManager по теме CorelDRAW, и при смене темы всё
  перекрашивается сразу. Шаблоны свои: стандартные Windows-шаблоны ComboBox/TabItem
  игнорируют цвет фона и в тёмной теме остаются белыми.

  Вид сделан по подходу Apple к интерфейсам: мягкие скругления, волосяные линии вместо жирных
  рамок, спокойный акцент, крупные и удобные для попадания элементы, отклик ровно в момент
  нажатия (кнопка чуть вдавливается). Цвета при этом остаются цветами CorelDRAW, чтобы докер
  не выбивался из программы.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Значения на случай, если тема ещё не применена (например, в дизайнере). -->
    <SolidColorBrush x:Key="Strassio.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Strassio.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Strassio.MutedForeground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Strassio.ControlBackground" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="Strassio.ControlBorder" Color="#B2B2B2"/>
    <SolidColorBrush x:Key="Strassio.InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Strassio.HoverBackground" Color="#E0F0FF"/>
    <SolidColorBrush x:Key="Strassio.SelectedBackground" Color="#CEE3FF"/>
    <SolidColorBrush x:Key="Strassio.Accent" Color="#0078D7"/>
    <SolidColorBrush x:Key="Strassio.AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Strassio.CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Strassio.Separator" Color="#18000000"/>
    <SolidColorBrush x:Key="Strassio.AccentSoft" Color="#1A0078D7"/>
    <!-- Рамка поля с неверным числом — одинаково заметна в светлой и тёмной теме. -->
    <SolidColorBrush x:Key="Strassio.Error" Color="#E53935"/>

    <!-- Одно скругление на весь докер: поля и кнопки — 6, карточки и списки — 10. -->
    <CornerRadius x:Key="Strassio.Radius">6</CornerRadius>
    <CornerRadius x:Key="Strassio.RadiusCard">10</CornerRadius>

    <!-- ── Текст ───────────────────────────────────────────────────────────── -->

    <!-- Подсказка под полем, пояснение: тише основного текста. -->
    <Style x:Key="Strassio.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.MutedForeground}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Подпись слева от поля. -->
    <Style x:Key="Strassio.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.MutedForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- Название блока («Камень», «Параметры») — мельче основного текста, но плотнее. -->
    <Style x:Key="Strassio.Section" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <!-- Заголовок докера. -->
    <Style x:Key="Strassio.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Карточка: блок параметров, слегка приподнятый над фоном докера. -->
    <Style x:Key="Strassio.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Strassio.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.Separator}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Strassio.RadiusCard}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Тонкая линия между блоками вместо жирной рамки. -->
    <Style x:Key="Strassio.Rule" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Strassio.Separator}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Strassio.CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.Separator}"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="9,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Кнопка ──────────────────────────────────────────────────────────── -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource Strassio.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Нажатие видно сразу: кнопка чуть вдавливается (в момент нажатия, а не после отпускания). -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Strassio.Radius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.HoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.SelectedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная кнопка («Создать») -->
    <Style x:Key="Strassio.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Strassio.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Strassio.AccentForeground}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Strassio.Radius}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка-значок (шестерёнка, карандаш, дискета, корзина): квадрат без рамки. -->
    <Style x:Key="Strassio.IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Поле ввода ──────────────────────────────────────────────────────── -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource Strassio.InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.ControlBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Strassio.Radius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Галочка ─────────────────────────────────────────────────────────── -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" VerticalAlignment="Center"
                                Background="{DynamicResource Strassio.InputBackground}"
                                BorderBrush="{DynamicResource Strassio.ControlBorder}" BorderThickness="1"
                                SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <Path x:Name="Mark" Data="M 3.5,8.5 L 6.8,11.6 L 13.2,4.6" Stroke="{DynamicResource Strassio.AccentForeground}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Strassio.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Выпадающий список ───────────────────────────────────────────────── -->

    <ControlTemplate x:Key="Strassio.ComboBoxToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{DynamicResource Strassio.InputBackground}" BorderBrush="{DynamicResource Strassio.ControlBorder}"
                BorderThickness="1" CornerRadius="{StaticResource Strassio.Radius}" SnapsToDevicePixels="True">
            <!-- Галочка-«шеврон» вместо залитого треугольника: спокойнее и лучше читается. -->
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                  Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Strassio.MutedForeground}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Strassio.Foreground}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource Strassio.ComboBoxToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="9,2,26,2" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <!-- Отступ снаружи — чтобы тень списка не обрезалась. -->
                            <Border Padding="6" Background="Transparent">
                                <Border Background="{DynamicResource Strassio.CardBackground}" BorderBrush="{DynamicResource Strassio.Separator}"
                                        BorderThickness="1" CornerRadius="8" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="8,5" Margin="0,1" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.SelectedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Вкладки: сегменты в одной «таблетке» ────────────────────────────── -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Strassio.ControlBackground}"
                                CornerRadius="9" Padding="3" SnapsToDevicePixels="True">
                            <WrapPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.MutedForeground}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Padding="11,5" Margin="1" CornerRadius="7" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.CardBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Полоса прокрутки: тонкая, без стрелок ───────────────────────────── -->

    <Style x:Key="Strassio.ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource Strassio.ControlBorder}" CornerRadius="3" Margin="3,2"
                            Opacity="0.65" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Strassio.ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Список (размеры камней, цвета размера) ──────────────────────────── -->

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource Strassio.InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Strassio.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Strassio.Radius}"
                            Padding="3" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Strassio.Foreground}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Padding="7,4" Margin="0,1" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Strassio.SelectedBackground}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Образцы цвета камня: кружки с кольцом выбора ────────────────────── -->

    <Style x:Key="Strassio.Swatches" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- Кольцо выбора идёт с просветом вокруг камня — так видно и светлые цвета. -->
                                <Border x:Name="Ring" Margin="0,0,5,5" Padding="2" CornerRadius="16" BorderThickness="2"
                                        BorderBrush="Transparent">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource Strassio.Separator}" BorderThickness="1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Strassio.ControlBorder}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Strassio.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
