<!--
  Докер Strassio (docs/SPEC.md, раздел 2.2). Тексты — только из файлов языков: DataContext
  корня — Localizer, привязка {Binding [ключ]} обновляется сама при смене языка.
  Цвета — DynamicResource "Strassio.*" из темы CorelDRAW (Themes/ThemeManager.cs).
-->
<UserControl x:Class="Strassio.Corel.Docker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="280"
             MinWidth="220"
             Background="{DynamicResource Strassio.Background}"
             Foreground="{DynamicResource Strassio.Foreground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Три блока — камень, метод с параметрами, кнопки с предпросмотром. Вертикальная раскладка ставит
      их друг под другом, горизонтальная — рядом (Docker.Layout.cs, настройка «Раскладка»).
    -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="LayoutGrid" Margin="10">
          <StackPanel x:Name="StoneSection">

            <!-- Шапка -->
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource Strassio.IconButton}" Click="Settings_Click"
                        ToolTip="{Binding [docker.settings.tooltip]}"
                        FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" Content="&#xE713;"/>
                <TextBlock Text="{Binding [app.title]}" Style="{StaticResource Strassio.Title}"/>
            </DockPanel>
            <!-- Пробный период / «нет лицензии»; при действующей лицензии не видна -->
            <TextBlock x:Name="LicenseLine" Style="{StaticResource Strassio.Muted}" Margin="0,-4,0,10"
                       Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="LicenseLine_Click"/>
            <!-- Доступна новая версия (SPEC 14.1); нет обновления — не видна -->
            <TextBlock x:Name="UpdateLine" Style="{StaticResource Strassio.Muted}" Margin="0,-4,0,10"
                       Foreground="{DynamicResource Strassio.Accent}" TextDecorations="Underline"
                       Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="UpdateLine_Click"/>

            <!-- Камень: размер и цвет -->
            <TextBlock Text="{Binding [docker.stone]}" Style="{StaticResource Strassio.Section}"/>
            <Grid x:Name="SetRow" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [docker.set]}" Style="{StaticResource Strassio.Caption}"/>
                <ComboBox x:Name="SetCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="SetCombo_SelectionChanged"
                          ToolTip="{Binding [docker.set.tooltip]}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [docker.size]}" Style="{StaticResource Strassio.Caption}"/>
                <ComboBox x:Name="SizeCombo" Grid.Column="1" DisplayMemberPath="Text"
                          ToolTip="{Binding [docker.size.tooltip]}" SelectionChanged="SizeCombo_SelectionChanged"/>
                <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource Strassio.IconButton}" Click="EditStones_Click"
                        ToolTip="{Binding [docker.stones.tooltip]}"
                        FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" Content="&#xE70F;"/>
            </Grid>
            <DockPanel Margin="0,0,0,2">
                <TextBlock Text="{Binding [docker.color]}" Style="{StaticResource Strassio.Caption}"/>
                <TextBlock x:Name="ColorName" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <ListBox x:Name="ColorList" Style="{StaticResource Strassio.Swatches}" Margin="0,0,0,10"
                     ToolTip="{Binding [docker.color.tooltip]}" SelectionChanged="ColorList_SelectionChanged"/>
          </StackPanel>

          <StackPanel x:Name="MethodSection">
            <!-- Метод -->
            <TabControl x:Name="MethodTabs" SelectionChanged="MethodTabs_SelectionChanged">
                <TabItem x:Name="LineTab" Header="{Binding [docker.tab.line]}"/>
                <TabItem x:Name="FillTab" Header="{Binding [docker.tab.fill]}"/>
                <TabItem x:Name="TextTab" Header="{Binding [docker.tab.text]}"/>
                <TabItem x:Name="MotifTab" Header="{Binding [docker.tab.motif]}"/>
                <TabItem x:Name="EditTab" Header="{Binding [docker.tab.edit]}"/>
                <TabItem x:Name="ColorTab" Header="{Binding [docker.tab.color]}"/>
                <TabItem x:Name="VectorTab" Header="{Binding [docker.tab.vector]}"/>
            </TabControl>

            <!-- «Текст» (docs/SPEC.md, раздел 10.1): надпись стразами одной кнопкой — Docker.Text.cs -->
            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding [text.title]}" Style="{StaticResource Strassio.Section}"/>
                <TextBlock Text="{Binding [text.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,8"/>
                <ComboBox x:Name="TextModeCombo" DisplayMemberPath="Text" Margin="0,0,0,4"
                          SelectionChanged="TextModeCombo_SelectionChanged" ToolTip="{Binding [text.mode.tooltip]}"/>
                <TextBlock x:Name="TextModeHint" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <Grid x:Name="TextThinRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [param.thinSize]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [param.thinSize.tooltip]}"/>
                    <ContentControl x:Name="TextThinHost" Grid.Column="1"/>
                </Grid>
                <Button Content="{Binding [text.check]}" Click="TextCheck_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [text.check.tooltip]}"/>
                <Button Content="{Binding [text.make]}" Click="TextMake_Click" Margin="0,0,0,8"
                        Style="{StaticResource Strassio.PrimaryButton}" ToolTip="{Binding [text.make.tooltip]}"/>
                <TextBlock Text="{Binding [text.note]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- «Мотивы» (docs/SPEC.md, раздел 9): библиотека, по линии, рамкой, по кругу — Docker.Motifs.cs -->
            <StackPanel x:Name="MotifPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding [motif.title]}" Style="{StaticResource Strassio.Section}"/>
                <TextBlock Text="{Binding [motif.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MotifCombo" DisplayMemberPath="Text" ToolTip="{Binding [motif.list.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [motif.delete]}" Click="MotifDelete_Click" Padding="10,4"
                            ToolTip="{Binding [motif.delete.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [motif.save]}" Click="MotifSave_Click" ToolTip="{Binding [motif.save.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [motif.folder]}" Click="MotifFolder_Click" Padding="10,4"
                            ToolTip="{Binding [motif.folder.tooltip]}"/>
                </Grid>

                <TextBlock Text="{Binding [motif.layout]}" Style="{StaticResource Strassio.Section}"/>
                <ComboBox x:Name="MotifModeCombo" DisplayMemberPath="Text" Margin="0,0,0,4"
                          SelectionChanged="MotifModeCombo_SelectionChanged" ToolTip="{Binding [motif.mode.tooltip]}"/>
                <TextBlock x:Name="MotifModeHint" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MotifSecondCaption" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.second.tooltip]}"/>
                    <ComboBox x:Name="MotifSecondCombo" Grid.Column="1" DisplayMemberPath="Text"
                              ToolTip="{Binding [motif.second.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [motif.count]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.count.tooltip]}"/>
                    <TextBox x:Name="MotifCountBox" Grid.Column="1" ToolTip="{Binding [motif.count.tooltip]}"/>
                    <TextBlock Grid.Column="3" Text="{Binding [motif.spacing]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.spacing.tooltip]}"/>
                    <TextBox x:Name="MotifSpacingBox" Grid.Column="4" TextChanged="MotifSpacingBox_TextChanged"
                             ToolTip="{Binding [motif.spacing.tooltip]}"/>
                </Grid>
                <CheckBox x:Name="MotifRotateBox" Content="{Binding [motif.rotate]}" IsChecked="True" Margin="0,0,0,4"
                          ToolTip="{Binding [motif.rotate.tooltip]}"/>
                <CheckBox x:Name="MotifFlipBox" Content="{Binding [motif.flip]}" Margin="0,0,0,6"
                          ToolTip="{Binding [motif.flip.tooltip]}"/>
                <Button Content="{Binding [motif.place]}" Click="MotifPlace_Click" Margin="0,0,0,14"
                        Style="{StaticResource Strassio.PrimaryButton}" ToolTip="{Binding [motif.place.tooltip]}"/>

                <TextBlock Text="{Binding [motif.around]}" Style="{StaticResource Strassio.Section}"/>
                <TextBlock Text="{Binding [motif.around.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [motif.around.make]}" Click="MotifAround_Click" ToolTip="{Binding [motif.around.make.tooltip]}"/>
                    <TextBox x:Name="MotifAroundBox" Grid.Column="2" ToolTip="{Binding [motif.around.count.tooltip]}"/>
                </Grid>

                <TextBlock Text="{Binding [motif.splash]}" Style="{StaticResource Strassio.Section}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding [motif.splash.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [motif.splash.make]}" Click="Splash_Click" ToolTip="{Binding [motif.splash.make.tooltip]}"/>
                    <TextBox x:Name="SplashWidthBox" Grid.Column="2" TextChanged="SplashWidthBox_TextChanged"
                             ToolTip="{Binding [motif.splash.width.tooltip]}"/>
                </Grid>

                <!-- Раппорт: повтор плитки по ткани без наложений на стыках — Docker.Repeat.cs -->
                <TextBlock Text="{Binding [motif.repeat]}" Style="{StaticResource Strassio.Section}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding [motif.repeat.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <ComboBox x:Name="RepeatShiftCombo" DisplayMemberPath="Text" Margin="0,0,0,6"
                          ToolTip="{Binding [motif.repeat.shift.tooltip]}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [motif.repeat.columns]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.repeat.columns.tooltip]}"/>
                    <TextBox x:Name="RepeatColumnsBox" Grid.Column="1" ToolTip="{Binding [motif.repeat.columns.tooltip]}"/>
                    <TextBlock Grid.Column="3" Text="{Binding [motif.repeat.rows]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.repeat.rows.tooltip]}"/>
                    <TextBox x:Name="RepeatRowsBox" Grid.Column="4" ToolTip="{Binding [motif.repeat.rows.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [motif.repeat.stepX]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.repeat.step.tooltip]}"/>
                    <TextBox x:Name="RepeatStepXBox" Grid.Column="1" ToolTip="{Binding [motif.repeat.step.tooltip]}"/>
                    <TextBlock Grid.Column="3" Text="{Binding [motif.repeat.stepY]}" Style="{StaticResource Strassio.Caption}"
                               ToolTip="{Binding [motif.repeat.step.tooltip]}"/>
                    <TextBox x:Name="RepeatStepYBox" Grid.Column="4" ToolTip="{Binding [motif.repeat.step.tooltip]}"/>
                </Grid>
                <Button Content="{Binding [motif.repeat.make]}" Click="Repeat_Click" Margin="0,0,0,8"
                        Style="{StaticResource Strassio.PrimaryButton}" ToolTip="{Binding [motif.repeat.make.tooltip]}"/>
            </StackPanel>

            <!-- «Правка» (docs/SPEC.md, раздел 7): режимы удаления, дубли, закрепление — Docker.Edit.cs -->
            <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding [edit.delete]}" Style="{StaticResource Strassio.Section}"/>
                <ComboBox x:Name="DeleteModeCombo" DisplayMemberPath="Text" Margin="0,0,0,4"
                          SelectionChanged="DeleteModeCombo_SelectionChanged"/>
                <TextBlock x:Name="DeleteModeHint" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <CheckBox x:Name="TouchingBox" Content="{Binding [edit.touching]}" ToolTip="{Binding [edit.touching.tooltip]}"
                          Margin="0,0,0,6"/>
                <Button Content="{Binding [edit.apply]}" Click="ApplyDelete_Click" Margin="0,0,0,14"
                        Style="{StaticResource Strassio.PrimaryButton}" ToolTip="{Binding [edit.apply.tooltip]}"/>

                <TextBlock Text="{Binding [edit.tools]}" Style="{StaticResource Strassio.Section}"/>
                <Button Content="{Binding [edit.duplicates]}" Click="Duplicates_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.duplicates.tooltip]}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [edit.lock]}" Click="Lock_Click" ToolTip="{Binding [edit.lock.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [edit.unlock]}" Click="Unlock_Click" ToolTip="{Binding [edit.unlock.tooltip]}"/>
                </Grid>
                <Button Content="{Binding [edit.restoreSize]}" Click="RestoreSize_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.restoreSize.tooltip]}"/>
                <Button Content="{Binding [edit.fillHoles]}" Click="FillHoles_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.fillHoles.tooltip]}"/>
                <Button Content="{Binding [edit.showUneven]}" Click="ShowUneven_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.showUneven.tooltip]}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [edit.evenGaps]}" Click="EvenGaps_Click" ToolTip="{Binding [edit.evenGaps.tooltip]}"/>
                    <TextBox x:Name="EvenShiftBox" Grid.Column="2" TextChanged="EvenShiftBox_TextChanged" ToolTip="{Binding [edit.evenShift.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MirrorSideCombo" DisplayMemberPath="Text" ToolTip="{Binding [edit.mirror.side.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [edit.mirror]}" Click="Mirror_Click" Padding="10,4" ToolTip="{Binding [edit.mirror.tooltip]}"/>
                </Grid>
                <Button Content="{Binding [edit.updateLive]}" Click="UpdateLive_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.updateLive.tooltip]}"/>
                <Button Content="{Binding [edit.resizeLive]}" Click="ResizeLive_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [edit.resizeLive.tooltip]}"/>
                <TextBlock Text="{Binding [edit.scope]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,14"/>

                <!-- Производство (раздел 11) -->
                <TextBlock Text="{Binding [prod.title]}" Style="{StaticResource Strassio.Section}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [prod.bridges]}" Click="CheckBridges_Click" ToolTip="{Binding [prod.bridges.tooltip]}"/>
                    <TextBox x:Name="BridgeBox" Grid.Column="2" TextChanged="BridgeBox_TextChanged" ToolTip="{Binding [prod.bridgeMin.tooltip]}"/>
                </Grid>
                <Button Content="{Binding [prod.count]}" Click="CountStones_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [prod.count.tooltip]}"/>
                <Button Content="{Binding [prod.layers]}" Click="LayersBySize_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [prod.layers.tooltip]}"/>
                <Button Content="{Binding [prod.layersColor]}" Click="LayersBySizeColor_Click" Margin="0,0,0,6"
                        ToolTip="{Binding [prod.layersColor.tooltip]}"/>
                <Button Content="{Binding [prod.clean]}" Click="CleanCircles_Click" Margin="0,0,0,8"
                        ToolTip="{Binding [prod.clean.tooltip]}"/>
            </StackPanel>

            <!-- «Цвет» (docs/SPEC.md, раздел 3.4): перекраска и выделение по размеру/цвету — Docker.Edit.cs -->
            <StackPanel x:Name="ColorPanel" Visibility="Collapsed">
                <Button Content="{Binding [color.pipette]}" Click="Pipette_Click" Margin="0,0,0,10"
                        ToolTip="{Binding [color.pipette.tooltip]}"/>
                <Button x:Name="RecolorButton" Click="Recolor_Click" Margin="0,0,0,4"
                        Style="{StaticResource Strassio.PrimaryButton}" ToolTip="{Binding [color.recolor.tooltip]}"/>
                <TextBlock Text="{Binding [color.recolor.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,10"/>

                <!-- Цвет крайних рядов: кант другим цветом у любой раскладки — Docker.EdgeColor.cs -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="EdgeRecolorButton" Click="EdgeRecolor_Click" ToolTip="{Binding [color.edge.tooltip]}"/>
                    <TextBox x:Name="EdgeRowsBox" Grid.Column="2" Text="1" ToolTip="{Binding [color.edge.rows.tooltip]}"/>
                </Grid>
                <TextBlock Text="{Binding [color.edge.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,14"/>

                <!-- Цвет по рисунку: стразы берут цвета фигур рисунка — Docker.Artwork.cs -->
                <TextBlock Text="{Binding [color.artwork.title]}" Style="{StaticResource Strassio.Section}"/>
                <Button Content="{Binding [color.artwork]}" Click="ArtworkRecolor_Click" Margin="0,0,0,4"
                        ToolTip="{Binding [color.artwork.tooltip]}"/>
                <TextBlock Text="{Binding [color.artwork.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,14"/>

                <TextBlock Text="{Binding [color.select]}" Style="{StaticResource Strassio.Section}"/>
                <Button x:Name="SelectSizeButton" Click="SelectSize_Click" Margin="0,0,0,6"/>
                <Button x:Name="SelectColorButton" Click="SelectColor_Click" Margin="0,0,0,6"/>
                <Button x:Name="SelectBothButton" Click="SelectBoth_Click" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding [color.select.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,14"/>

                <!-- Смешение цветов (раздел 3.4): 2–3 цвета, доли в процентах или «по очереди» -->
                <TextBlock Text="{Binding [color.mix]}" Style="{StaticResource Strassio.Section}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="MixColor1" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                    <TextBox x:Name="MixValue1" Grid.Column="2" Text="70" Margin="0,0,0,4" ToolTip="{Binding [color.mix.value.tooltip]}"/>
                    <ComboBox x:Name="MixColor2" Grid.Row="1" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                    <TextBox x:Name="MixValue2" Grid.Row="1" Grid.Column="2" Text="30" Margin="0,0,0,4" ToolTip="{Binding [color.mix.value.tooltip]}"/>
                    <ComboBox x:Name="MixColor3" Grid.Row="2" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                    <TextBox x:Name="MixValue3" Grid.Row="2" Grid.Column="2" Text="0" Margin="0,0,0,4" ToolTip="{Binding [color.mix.value.tooltip]}"/>
                </Grid>
                <ComboBox x:Name="MixModeCombo" DisplayMemberPath="Text" Margin="0,0,0,6" ToolTip="{Binding [color.mix.mode.tooltip]}"/>
                <Button Content="{Binding [color.mix.apply]}" Click="Mix_Click" Margin="0,0,0,4" ToolTip="{Binding [color.mix.apply.tooltip]}"/>
                <TextBlock Text="{Binding [color.mix.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,14"/>

                <Button Content="{Binding [color.palette]}" Click="Palette_Click" Margin="0,0,0,8"
                        ToolTip="{Binding [color.palette.tooltip]}"/>
            </StackPanel>

            <!-- «Векторы» (docs/SPEC.md, раздел 10): подготовка линий — Docker.Vector.cs -->
            <StackPanel x:Name="VectorPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding [vec.lines]}" Style="{StaticResource Strassio.Section}"/>
                <TextBlock Text="{Binding [vec.offset]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.offsetOut]}" Click="OffsetOut_Click" ToolTip="{Binding [vec.offset.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [vec.offsetIn]}" Click="OffsetIn_Click" ToolTip="{Binding [vec.offset.tooltip]}"/>
                    <TextBox x:Name="OffsetBox" Grid.Column="4" ToolTip="{Binding [vec.distance.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.parallel]}" Click="Parallel_Click" ToolTip="{Binding [vec.parallel.tooltip]}"/>
                    <TextBox x:Name="ParallelCountBox" Grid.Column="2" Text="3" ToolTip="{Binding [vec.count.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ParallelBothBox" Content="{Binding [vec.bothSides]}" IsChecked="True" VerticalAlignment="Center"/>
                    <TextBox x:Name="ParallelStepBox" Grid.Column="2" ToolTip="{Binding [vec.step.tooltip]}"/>
                </Grid>
                <CheckBox x:Name="SharpCornersBox" Content="{Binding [vec.sharp]}" ToolTip="{Binding [vec.sharp.tooltip]}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.split]}" Click="Split_Click" ToolTip="{Binding [vec.split.tooltip]}"/>
                    <TextBox x:Name="SplitBox" Grid.Column="2" Text="2" ToolTip="{Binding [vec.parts.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.join]}" Click="Join_Click" ToolTip="{Binding [vec.join.tooltip]}"/>
                    <TextBox x:Name="JoinToleranceBox" Grid.Column="2" ToolTip="{Binding [vec.tolerance.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.close]}" Click="Close_Click" ToolTip="{Binding [vec.close.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [vec.gaps]}" Click="Gaps_Click" ToolTip="{Binding [vec.gaps.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.reverse]}" Click="Reverse_Click" ToolTip="{Binding [vec.reverse.tooltip]}"/>
                    <Button Grid.Column="2" Content="{Binding [vec.start]}" Click="ShowStart_Click" ToolTip="{Binding [vec.start.tooltip]}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [vec.smooth]}" Click="Smooth_Click" ToolTip="{Binding [vec.smooth.tooltip]}"/>
                    <TextBox x:Name="SmoothBox" Grid.Column="2" ToolTip="{Binding [vec.smoothTolerance.tooltip]}"/>
                </Grid>
                <Button Content="{Binding [vec.centerline]}" Click="Centerline_Click" Margin="0,0,0,14"
                        ToolTip="{Binding [vec.centerline.tooltip]}"/>

                <TextBlock Text="{Binding [vec.checkTitle]}" Style="{StaticResource Strassio.Section}"/>
                <Button Content="{Binding [vec.check]}" Click="Check_Click" Margin="0,0,0,6" ToolTip="{Binding [vec.check.tooltip]}"/>
                <TextBlock Text="{Binding [vec.hint]}" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="MethodPanel">
            <!-- Пресеты и недавние настройки (раздел 8) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [docker.preset]}" Style="{StaticResource Strassio.Caption}"/>
                <ComboBox x:Name="PresetCombo" Grid.Column="1" DisplayMemberPath="Text" SelectionChanged="PresetCombo_SelectionChanged"
                          ToolTip="{Binding [docker.preset.tooltip]}"/>
                <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource Strassio.IconButton}" Click="SavePreset_Click" ToolTip="{Binding [docker.preset.save]}"
                        FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" Content="&#xE74E;"/>
                <Button x:Name="DeletePresetButton" Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource Strassio.IconButton}" Click="DeletePreset_Click"
                        ToolTip="{Binding [docker.preset.delete]}" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" Content="&#xE74D;"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [docker.method]}" Style="{StaticResource Strassio.Caption}"/>
                <ComboBox x:Name="MethodCombo" Grid.Column="1" SelectionChanged="MethodCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="MethodHint" Style="{StaticResource Strassio.Muted}" Margin="0,0,0,12"/>

            <!-- Параметры выбранного метода: поля строятся из Strassio.Core.Methods.MethodCatalog (Docker.Params.cs) -->
            <TextBlock x:Name="ParamsHeader" Text="{Binding [docker.params]}" Style="{StaticResource Strassio.Section}"/>
            <Grid x:Name="ParamsGrid" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="140"/>
                    <ColumnDefinition Width="*" MinWidth="70"/>
                </Grid.ColumnDefinitions>
            </Grid>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="ActionSection">
            <!-- Низ: «Предпросмотр» (картинка в докере, документ не меняется) и «Создать» -->
            <Grid x:Name="CreateRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviewButton" Click="Preview_Click" Padding="10,6"
                        Content="{Binding [docker.preview]}" ToolTip="{Binding [docker.preview.tooltip]}"/>
                <Button x:Name="CreateButton" Grid.Column="2" Style="{StaticResource Strassio.PrimaryButton}" Click="Create_Click"
                        Content="{Binding [docker.create]}" ToolTip="{Binding [docker.create.tooltip]}"/>
            </Grid>
            <CheckBox x:Name="LivePreviewBox" Content="{Binding [docker.livePreview]}" Click="LivePreviewBox_Click"
                      ToolTip="{Binding [docker.livePreview.tooltip]}" Margin="0,8,0,0"/>
            <CheckBox x:Name="AvoidExistingBox" Content="{Binding [docker.avoidExisting]}" Click="AvoidExistingBox_Click"
                      ToolTip="{Binding [docker.avoidExisting.tooltip]}" Margin="0,6,0,0"/>
            <CheckBox x:Name="ColorFromShapeBox" Content="{Binding [docker.colorFromShape]}" Click="ColorFromShapeBox_Click"
                      ToolTip="{Binding [docker.colorFromShape.tooltip]}" Margin="0,6,0,0"/>
            <Border x:Name="PreviewPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="8" CornerRadius="10"
                    Background="#FFFFFF" BorderBrush="{DynamicResource Strassio.Separator}" BorderThickness="1">
                <StackPanel>
                    <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="260"/>
                    <Button Content="{Binding [variant.pin]}" Click="PinVariant_Click" HorizontalAlignment="Right"
                            Padding="10,3" Margin="0,6,0,0" ToolTip="{Binding [variant.pin.tooltip]}"/>
                    <UniformGrid x:Name="VariantStrip" Rows="1" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource Strassio.Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
