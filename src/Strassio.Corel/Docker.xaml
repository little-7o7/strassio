<UserControl x:Class="Strassio.Corel.Docker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">
    <StackPanel Margin="10">
        <TextBlock Text="Strassio" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.8"
                   Text="Докер пока пустой (Этап 0-1). Кнопки ниже — технические проверки, не окончательный интерфейс."/>
        <Button x:Name="CreateTestStoneButton" Padding="8,4" Click="CreateTestStone_Click"
                Content="Создать тестовую стразу (ss6)"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,4" Opacity="0.8"
                   Text="Выделите нарисованную линию (перо/кривая Безье) и нажмите — обведёт её стразами ss6 методом L1 «по линии», одной группой отмены."/>
        <Button x:Name="ScatterSelectedCurveButton" Padding="8,4" Click="ScatterSelectedCurve_Click"
                Content="Обвести выделенную кривую (L1, тест)"/>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
